        &quot;ANOFABRI&quot;: ANOFABRI + &quot;&quot;,
        &quot;ANOMODELO&quot;: ANOMODELO + &quot;&quot;,
        &quot;NUMECHAS&quot;: NUMECHAS + &quot;&quot;,
        &quot;PLACA&quot;: PLACA + &quot;&quot;,
        &quot;ALUGUEL_CONTRATO&quot;: ALUGUEL_CONTRATO + &quot;&quot;,
        &quot;DESCRICAO&quot;: DESCRICAO + &quot;&quot;,
        &quot;POTENCIAHP_UNID&quot;: POTENCIAHP_UNID + &quot;&quot;,
        &quot;POTENCIAHP&quot;: POTENCIAHP + &quot;&quot;,
        &quot;DATACHEGADA&quot;: DATACHEGADA + &quot;&quot;,
        &quot;MESANO&quot;: MESANO + &quot;&quot;,

        &quot;VALOR_MOBILIZADO&quot;: VALOR_MOBILIZADO + &quot;&quot;,
        &quot;TIPO_VALOR_MOBILIZADO&quot;: TIPO_VALOR_MOBILIZADO + &quot;&quot;,

