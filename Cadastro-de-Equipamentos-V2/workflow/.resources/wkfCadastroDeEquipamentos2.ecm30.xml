    var consumoMedio = hAPI.getCardValue(&quot;consumoMedio&quot;);

    var CODIMEDI = tipoConsumoMedio == &quot;km/L&quot; ? 1 : 2;

    var CONSUMO_KM = tipoConsumoMedio == &quot;km/L&quot; ? consumoMedio : &quot;&quot;;
    var CONSUMO_HORA = tipoConsumoMedio == &quot;L/H&quot; ? consumoMedio : &quot;&quot;;

